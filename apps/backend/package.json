{
  "name": "backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": " tsx watch app.ts ",
    "start": " tsx app.ts",
    "build": "prisma db pull && prisma generate",
    "db:pull": "prisma db pull --schema prisma/schema.prisma",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:push": "prisma db push --schema prisma/schema.prisma",
    "db:migrate:dev": "prisma migrate dev --schema prisma/schema.prisma",
    "db:migrate:reset": "prisma migrate reset --schema prisma/schema.prisma",
    "db:studio": "prisma studio --schema prisma/schema.prisma"
  },
  "dependencies": {
    "tsx": "^4.21.0",
    "@prisma/adapter-pg": "^7.7.0",
    "@prisma/client": "^7.7.0",
    "@supabase/supabase-js": "^2.102.1",
    "auth0": "^5.6.0",
    "cors": "^2.8.6",
    "db": "*",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-jwt": "^8.5.1",
    "express-oauth2-jwt-bearer": "^1.7.4",
    "jwks-rsa": "^4.0.1",
    "morgan": "^1.10.1",
    "multer": "^2.1.1",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^24.12.0",
    "@types/pg": "^8.20.0",
    "nodemon": "^3.1.14",
    "prisma": "^7.7.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.2"
  }
}
