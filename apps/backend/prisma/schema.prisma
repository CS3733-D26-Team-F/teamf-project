generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model admin {
  adid     Int      @id
  employee employee @relation(fields: [adid], references: [empid], onDelete: Cascade, onUpdate: NoAction, map: "Admin_employeeId_fkey")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model contentform {
  id                Int               @id @default(autoincrement())
  name              String            @unique @db.VarChar(100)
  url               String            @unique @db.VarChar(2083)
  owner             String?           @db.VarChar(50)
  persona           String[]          @db.VarChar
  date_modified     DateTime          @db.Date
  expiration_date   DateTime          @db.Date
  content_type      String            @db.VarChar(50)
  status            String            @db.VarChar(50)
  empid             Int?
  is_favorite       Boolean           @default(false)
  deleted_at        DateTime?         @db.Date
  is_deleted        Boolean           @default(false)
  checkout_username String?           @db.VarChar
  checkout_date     DateTime?         @db.Timestamptz(6)
  review_date       DateTime?         @db.Date
  folder_id         Int?
  warning           Boolean?
  changes           changes[]
  employee          employee?         @relation(fields: [empid], references: [empid])
  folder            folders?          @relation(fields: [folder_id], references: [id], onUpdate: NoAction)
  document_chunks   document_chunks[]
  joinedfavorites   joinedfavorites[]
  jointagscontent   jointagscontent[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model employee {
  empid                                      Int               @id @default(autoincrement())
  username                                   String            @unique @db.VarChar(50)
  password                                   String?           @db.VarChar(20)
  persona                                    String?           @db.VarChar(50)
  theme                                      Int?              @default(0)
  isLoggedIn                                 Boolean?          @default(false)
  auth0Id                                    String?           @unique @db.VarChar
  first_name                                 String?
  last_name                                  String?
  created_at                                 DateTime?         @default(now()) @db.Timestamp(6)
  pfp_URL                                    String?           @unique @db.VarChar
  widgets                                    String[]
  admin                                      admin?
  changes                                    changes[]
  contentform                                contentform[]
  folders                                    folders[]
  joinedfavorites                            joinedfavorites[]
  joinednotice                               joinednotice[]
  notifications                              notifications[]
  workflow_workflow_approver_idToemployee    workflow[]        @relation("workflow_approver_idToemployee")
  workflow_workflow_agent_idToemployee       workflow[]        @relation("workflow_agent_idToemployee")
  workflow_workflow_underwriter_idToemployee workflow[]        @relation("workflow_underwriter_idToemployee")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model folders {
  id               Int           @id @default(autoincrement())
  name             String        @db.VarChar(100)
  owner_empid      Int
  persona          String[]      @db.VarChar
  created_at       DateTime      @default(now()) @db.Timestamptz(6)
  updated_at       DateTime      @db.Timestamptz(6)
  url              String?       @db.VarChar(2083)
  allowed_users    String[]      @default([]) @db.VarChar
  deleted_at       DateTime?     @db.Date
  is_deleted       Boolean       @default(false)
  parent_folder_id Int?
  contentform      contentform[]
  employee         employee      @relation(fields: [owner_empid], references: [empid], onDelete: Cascade, onUpdate: NoAction)
  folders          folders?      @relation("foldersTofolders", fields: [parent_folder_id], references: [id], onUpdate: NoAction)
  other_folders    folders[]     @relation("foldersTofolders")

  @@unique([owner_empid, name], map: "uq_folders_owner_name")
  @@index([owner_empid], map: "idx_folders_owner_empid")
  @@index([parent_folder_id], map: "idx_folders_parent_folder_id")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model joinedfavorites {
  empid       Int
  id          Int
  employee    employee    @relation(fields: [empid], references: [empid], onDelete: Cascade, onUpdate: NoAction)
  contentform contentform @relation(fields: [id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([empid, id])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model joinednotice {
  empid         Int
  notid         Int
  read          Boolean?
  employee      employee      @relation(fields: [empid], references: [empid], onDelete: Cascade, onUpdate: NoAction)
  notifications notifications @relation(fields: [notid], references: [notid], onDelete: Cascade, onUpdate: NoAction)

  @@id([empid, notid])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model jointagscontent {
  id          Int
  metid       Int
  contentform contentform @relation(fields: [id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "join_meta_content_id_fkey")
  metatags    metatags    @relation(fields: [metid], references: [metid], onDelete: Cascade, onUpdate: NoAction, map: "join_meta_content_metid_fkey")

  @@id([id, metid], map: "join_meta_content_pkey")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model metatags {
  metid           Int               @id @default(autoincrement())
  tag_name        String            @unique @db.VarChar(50)
  jointagscontent jointagscontent[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model notifications {
  notid        Int            @id @default(autoincrement())
  title        String         @db.VarChar(50)
  message      String         @db.VarChar(256)
  send_date    DateTime       @db.Date
  importance   Int?
  sender       Int?
  joinednotice joinednotice[]
  employee     employee?      @relation(fields: [sender], references: [empid], onDelete: Cascade, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model changes {
  chad        Int          @id @default(autoincrement())
  id          Int?
  empid       Int?
  change      String?      @db.VarChar(50)
  date        DateTime?    @db.Timestamptz(6)
  employee    employee?    @relation(fields: [empid], references: [empid], onDelete: Cascade)
  contentform contentform? @relation(fields: [id], references: [id], onDelete: Cascade)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model document_chunks {
  id             BigInt                 @id @default(autoincrement())
  contentform_id Int?
  chunk_index    Int?
  content        String?
  embedding      Unsupported("vector")?
  created_at     DateTime?              @default(now()) @db.Timestamptz(6)
  contentform    contentform?           @relation(fields: [contentform_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([embedding])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model workflow {
  id                                         Int             @id @default(autoincrement())
  title                                      String          @unique @db.VarChar
  status                                     String          @db.VarChar
  created_at                                 DateTime?       @db.Timestamptz(6)
  agent_id                                   Int
  agent_status                               String?         @db.VarChar
  underwriter_id                             Int?
  underwriter_status                         String?         @db.VarChar
  approver_id                                Int?
  approver_status                            String?         @db.VarChar
  is_locked                                  Boolean?        @default(false)
  employee_workflow_approver_idToemployee    employee?       @relation("workflow_approver_idToemployee", fields: [approver_id], references: [empid], onDelete: NoAction, onUpdate: NoAction)
  employee_workflow_agent_idToemployee       employee        @relation("workflow_agent_idToemployee", fields: [agent_id], references: [empid], onDelete: NoAction, onUpdate: NoAction, map: "workflow_creator_id_fkey")
  employee_workflow_underwriter_idToemployee employee?       @relation("workflow_underwriter_idToemployee", fields: [underwriter_id], references: [empid], onDelete: NoAction, onUpdate: NoAction, map: "workflow_reviewer_id_fkey")
  workflow_form                              workflow_form[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model workflow_form {
  id               BigInt    @id @default(autoincrement())
  workflow_id      Int
  name             String?   @db.VarChar
  carrier          String?   @db.VarChar
  policy_type      String?   @db.VarChar
  limits_liability Float?    @db.Real
  expiration_date  DateTime? @db.Date
  rating           String?   @db.VarChar
  estimate         Float?    @db.Real
  coverage         Float?    @db.Real
  workflow         workflow  @relation(fields: [workflow_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}
